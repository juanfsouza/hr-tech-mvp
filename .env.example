# ─── RH TECH — Variáveis de Ambiente ──────────────────────────────────────────
# Copie este arquivo para apps/api/.env e preencha os valores

# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3333
API_URL=http://localhost:3333
FRONTEND_URL=http://localhost:3000

# ─── Database (gerado pelo Docker Compose) ─────────────────────────────────────
# Quando rodando via Docker, DATABASE_URL é sobrescrito pelo compose
# Preencha as partes usadas pelo docker-compose.yml:
DB_PASSWORD=postgres123
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/saasrh?schema=public"

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis123
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT (use chaves de no mínimo 32 caracteres) ───────────────────────────────
JWT_ACCESS_SECRET=TROQUE_POR_UMA_CHAVE_FORTE_DE_32_CHARS!!
JWT_REFRESH_SECRET=TROQUE_POR_OUTRA_CHAVE_FORTE_DE_32_CHARS!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Encryption (AES-256: exatamente 32 chars) ─────────────────────────────────
ENCRYPTION_KEY=

# ─── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Storage (Cloudflare R2 / AWS S3) ─────────────────────────────────────────
S3_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=seu_access_key
S3_SECRET_ACCESS_KEY=seu_secret_key
S3_BUCKET_NAME=
S3_PUBLIC_URL=https://assets.seudominio.com

# ─── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@seudominio.com
EMAIL_FROM_NAME=RH TECH

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── Test Portal ───────────────────────────────────────────────────────────────
TEST_LINK_EXPIRY_HOURS=72
CANDIDATE_PORTAL_URL=http://localhost:3000/teste
