generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  HR
  VIEWER
}

enum CompanyProfile {
  STARTUP
  CONSOLIDATED
  RESTRUCTURING
  OTHER
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum JobStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum CandidateStatus {
  REGISTERED
  TEST_SENT
  TEST_IN_PROGRESS
  TEST_COMPLETED
  ANALYZING
  APPROVED
  REJECTED
}

enum TestSessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum TestType {
  DISC
  ENNEAGRAM
  SIXTEEN_PERSONALITIES
}

model Company {
  id               String           @id @db.Uuid
  razaoSocial      String
  cnpj             String           @unique
  logoUrl          String?
  websiteUrl       String?
  cep              String?
  logradouro       String?
  numero           String?
  complemento      String?
  bairro           String?
  cidade           String?
  estado           String?
  companyProfile   CompanyProfile?
  companyContext   String?
  cultureValues    String[]         @default([])
  mainChallenges   String?
  leadershipStyle  String?
  onboardingStatus OnboardingStatus @default(PENDING)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  users         User[]
  collaborators Collaborator[]
  jobs          Job[]
  candidates    Candidate[]
  testSessions  TestSession[]
  matches       Match[]

  @@index([deletedAt])
}

model User {
  id           String    @id @db.Uuid
  companyId    String    @db.Uuid
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole
  avatarUrl    String?
  lastLoginAt  DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([companyId, isActive, deletedAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Collaborator {
  id         String    @id @db.Uuid
  companyId  String    @db.Uuid
  name       String
  email      String?
  role       String
  department String?
  parentId   String?   @db.Uuid
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent         Collaborator?  @relation("CollaboratorHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Collaborator[] @relation("CollaboratorHierarchy")
  responsibleFor Job[]          @relation("JobResponsible")
  psychProfiles  PsychProfile[]

  @@unique([companyId, email])
  @@index([companyId, parentId, deletedAt])
}

model Job {
  id            String    @id @db.Uuid
  companyId     String    @db.Uuid
  title         String
  description   String?
  requirements  String[]  @default([])
  salaryMin     Decimal?  @db.Decimal(12, 2)
  salaryMax     Decimal?  @db.Decimal(12, 2)
  location      String?
  isRemote      Boolean   @default(false)
  status        JobStatus @default(DRAFT)
  responsibleId String?   @db.Uuid
  aiGeneratedJd String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  responsible Collaborator? @relation("JobResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  candidates  Candidate[]
  matches     Match[]

  @@index([companyId, status, deletedAt])
}

model Candidate {
  id          String          @id @db.Uuid
  companyId   String          @db.Uuid
  jobId       String?         @db.Uuid
  name        String
  email       String
  phone       String?
  resumeUrl   String?
  status      CandidateStatus @default(REGISTERED)
  lgpdConsent Boolean         @default(false)
  consentAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job          Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  testSessions TestSession[]
  psychProfiles PsychProfile[]
  matches      Match[]

  @@index([companyId, jobId, status, deletedAt])
  @@unique([companyId, email])
}

model TestSession {
  id          String            @id @db.Uuid
  companyId   String            @db.Uuid
  candidateId String?           @db.Uuid
  token       String            @unique
  status      TestSessionStatus @default(PENDING)
  expiresAt   DateTime
  startedAt   DateTime?
  completedAt DateTime?
  currentTest TestType?
  createdAt   DateTime          @default(now())

  company    Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  candidate  Candidate?   @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  responses  TestResponse[]

  @@index([companyId, status, expiresAt])
  @@index([candidateId])
}

model TestResponse {
  id         String   @id @db.Uuid
  sessionId  String   @db.Uuid
  testType   TestType
  questionId String
  answer     String
  answeredAt DateTime @default(now())

  session TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, testType, questionId])
  @@index([sessionId, testType, answeredAt])
}

model PsychProfile {
  id             String   @id @db.Uuid
  candidateId    String?  @db.Uuid
  collaboratorId String?  @db.Uuid
  discD          Int?
  discI          Int?
  discS          Int?
  discC          Int?
  discDominant   String?
  discSecondary  String?
  enneagramType  Int?
  enneagramWing  String?
  enneagramLevel Int?
  mbtiType       String?
  bigFiveO       Int?
  bigFiveC       Int?
  bigFiveE       Int?
  bigFiveA       Int?
  bigFiveN       Int?
  completedAt    DateTime
  updatedAt      DateTime @updatedAt

  candidate    Candidate?    @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  collaborator Collaborator? @relation(fields: [collaboratorId], references: [id], onDelete: SetNull)

  @@index([candidateId, completedAt])
  @@index([collaboratorId, completedAt])
}

model Match {
  id               String   @id @db.Uuid
  candidateId      String   @db.Uuid
  jobId            String   @db.Uuid
  companyId        String   @db.Uuid
  overallScore     Int
  jobMatchScore    Int
  leaderMatchScore Int
  cultureMatchScore Int
  recommendation   String
  summary          String
  fullAnalysis     String
  createdAt        DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, candidateId, createdAt])
  @@index([jobId])
}
