// This is your Prisma schema file
// Clean Architecture: este schema é usado apenas na camada de infraestrutura

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector"), pg_trgm, uuidOssp(map: "uuid-ossp")]
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  HR
  VIEWER
}

enum CompanyProfile {
  STARTUP
  CONSOLIDATED
  RESTRUCTURING
  OTHER
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TestSessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum TestType {
  DISC
  ENNEAGRAM
  SIXTEEN_PERSONALITIES
}

enum CandidateStatus {
  REGISTERED
  TEST_SENT
  TEST_IN_PROGRESS
  TEST_COMPLETED
  ANALYZING
  APPROVED
  REJECTED
}

enum MatchRecommendation {
  STRONG_YES
  YES
  MAYBE
  NO
}

enum JobStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

// ─── Company (Tenant Raiz) ────────────────────────────────────────────────────

model Company {
  id               String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  razaoSocial      String          @map("razao_social")
  cnpj             String          @unique
  logoUrl          String?         @map("logo_url")
  websiteUrl       String?         @map("website_url")
  // Endereço
  cep              String?
  logradouro       String?
  numero           String?
  complemento      String?
  bairro           String?
  cidade           String?
  estado           String?
  // Contexto (alimenta IA)
  companyProfile   CompanyProfile? @map("company_profile")
  companyContext   String?         @map("company_context") // mín. 100 palavras
  cultureValues    String[]        @map("culture_values")  // tags
  mainChallenges   String?         @map("main_challenges")
  leadershipStyle  String?         @map("leadership_style")
  // Status
  onboardingStatus OnboardingStatus @default(PENDING) @map("onboarding_status")
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  // Relações
  users            User[]
  collaborators    Collaborator[]
  jobs             Job[]
  candidates       Candidate[]
  testSessions     TestSession[]
  aiAnalyses       AiAnalysis[]
  auditLogs        AuditLog[]

  @@index([cnpj])
  @@index([isActive, createdAt])
  @@map("companies")
}

// ─── User (Equipe de RH) ─────────────────────────────────────────────────────

model User {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId    String?   @map("company_id") @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         UserRole  @default(HR)
  avatarUrl    String?   @map("avatar_url")
  lastLoginAt  DateTime? @map("last_login_at")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  company      Company?       @relation(fields: [companyId], references: [id])
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]

  @@index([companyId, isActive])
  @@index([email])
  @@map("users")
}

// ─── Refresh Token ────────────────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ─── Collaborator (Organograma) ───────────────────────────────────────────────

model Collaborator {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  name         String
  email        String?
  role         String    // cargo
  department   String?
  parentId     String?   @map("parent_id") @db.Uuid // líder direto
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  company      Company        @relation(fields: [companyId], references: [id])
  parent       Collaborator?  @relation("Hierarchy", fields: [parentId], references: [id])
  subordinates Collaborator[] @relation("Hierarchy")
  psychProfile PsychProfile?

  @@index([companyId, isActive])
  @@index([parentId])
  @@map("collaborators")
}

// ─── Job (Vaga) ───────────────────────────────────────────────────────────────

model Job {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  title           String
  description     String?
  requirements    String[]
  salaryMin       Decimal?  @map("salary_min") @db.Decimal(10, 2)
  salaryMax       Decimal?  @map("salary_max") @db.Decimal(10, 2)
  location        String?
  isRemote        Boolean   @default(false) @map("is_remote")
  status          JobStatus @default(DRAFT)
  responsibleId   String?   @map("responsible_id") @db.Uuid // líder da vaga
  aiGeneratedJd   String?   @map("ai_generated_jd")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  company         Company        @relation(fields: [companyId], references: [id])
  candidates      Candidate[]
  embedding       JobEmbedding?

  @@index([companyId, status, createdAt])
  @@map("jobs")
}

// ─── JobEmbedding (pgvector para RAG) ────────────────────────────────────────

model JobEmbedding {
  id        String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobId     String                  @unique @map("job_id") @db.Uuid
  vector    Unsupported("vector(1536)")?  // OpenAI text-embedding-3-small = 1536 dims
  updatedAt DateTime                @updatedAt @map("updated_at")

  job       Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_embeddings")
}

// ─── Candidate (Candidato Externo) ───────────────────────────────────────────

model Candidate {
  id           String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId    String          @map("company_id") @db.Uuid
  jobId        String?         @map("job_id") @db.Uuid
  name         String
  email        String
  phone        String?
  resumeUrl    String?         @map("resume_url")
  status       CandidateStatus @default(REGISTERED)
  lgpdConsent  Boolean         @default(false) @map("lgpd_consent")
  consentAt    DateTime?       @map("consent_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  deletedAt    DateTime?       @map("deleted_at")

  company      Company        @relation(fields: [companyId], references: [id])
  job          Job?           @relation(fields: [jobId], references: [id])
  testSessions TestSession[]
  psychProfile PsychProfile?
  matches      Match[]

  @@index([companyId, status, createdAt])
  @@index([email, companyId])
  @@map("candidates")
}

// ─── TestSession (Link Único) ─────────────────────────────────────────────────

model TestSession {
  id          String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  candidateId String?          @map("candidate_id") @db.Uuid
  token       String           @unique           // token único no link
  status      TestSessionStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at")
  startedAt   DateTime?        @map("started_at")
  completedAt DateTime?        @map("completed_at")
  currentTest TestType?        @map("current_test")
  createdAt   DateTime         @default(now()) @map("created_at")

  company     Company        @relation(fields: [companyId], references: [id])
  candidate   Candidate?     @relation(fields: [candidateId], references: [id])
  responses   TestResponse[]

  @@index([token])
  @@index([companyId, status])
  @@map("test_sessions")
}

// ─── TestResponse (Respostas Brutas - Salvamento Incremental) ─────────────────

model TestResponse {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  testType     TestType @map("test_type")
  questionId   String   @map("question_id")
  answer       String   // JSON string para flexibilidade
  answeredAt   DateTime @default(now()) @map("answered_at")

  session      TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, testType, questionId]) // upsert por resposta
  @@index([sessionId, testType])
  @@map("test_responses")
}

// ─── PsychProfile (Resultado Calculado) ──────────────────────────────────────

model PsychProfile {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  candidateId     String?   @unique @map("candidate_id") @db.Uuid
  collaboratorId  String?   @unique @map("collaborator_id") @db.Uuid
  // DISC
  discD           Float?    @map("disc_d")
  discI           Float?    @map("disc_i")
  discS           Float?    @map("disc_s")
  discC           Float?    @map("disc_c")
  discDominant    String?   @map("disc_dominant")
  discSecondary   String?   @map("disc_secondary")
  // Eneagrama
  enneagramType   Int?      @map("enneagram_type")
  enneagramWing   String?   @map("enneagram_wing")
  enneagramLevel  Int?      @map("enneagram_level")
  // 16 Personalidades
  mbtiType        String?   @map("mbti_type")
  bigFiveO        Float?    @map("big_five_o")
  bigFiveC        Float?    @map("big_five_c")
  bigFiveE        Float?    @map("big_five_e")
  bigFiveA        Float?    @map("big_five_a")
  bigFiveN        Float?    @map("big_five_n")
  // Metadata
  completedAt     DateTime  @default(now()) @map("completed_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  candidate       Candidate?    @relation(fields: [candidateId], references: [id])
  collaborator    Collaborator? @relation(fields: [collaboratorId], references: [id])

  @@map("psych_profiles")
}

// ─── Match ─────────────────────────────────────────────────────────────────────

model Match {
  id               String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  candidateId      String              @map("candidate_id") @db.Uuid
  jobId            String              @map("job_id") @db.Uuid
  companyId        String              @map("company_id") @db.Uuid
  overallScore     Float               @map("overall_score")
  jobMatchScore    Float               @map("job_match_score")
  leaderMatchScore Float               @map("leader_match_score")
  cultureMatchScore Float              @map("culture_match_score")
  recommendation   MatchRecommendation
  summary          String
  fullAnalysis     Json                @map("full_analysis") // análise completa do Claude
  createdAt        DateTime            @default(now()) @map("created_at")

  candidate        Candidate           @relation(fields: [candidateId], references: [id])

  @@index([candidateId])
  @@index([jobId, overallScore(sort: Desc)])
  @@index([companyId, createdAt])
  @@map("matches")
}

// ─── AiAnalysis ───────────────────────────────────────────────────────────────

model AiAnalysis {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  entityType  String   @map("entity_type") // "candidate_match", "jd_generation", "chat"
  entityId    String   @map("entity_id") @db.Uuid
  promptHash  String   @map("prompt_hash") // SHA-256 para deduplication
  model       String   // "claude-sonnet-4", etc.
  inputTokens Int      @map("input_tokens")
  outputTokens Int     @map("output_tokens")
  createdAt   DateTime @default(now()) @map("created_at")

  company     Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, entityType, createdAt])
  @@map("ai_analyses")
}

// ─── AuditLog (LGPD) ─────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   // ex: "candidate.delete", "test.complete"
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  company    Company @relation(fields: [companyId], references: [id])
  user       User?   @relation(fields: [userId], references: [id])

  @@index([companyId, action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
